# === Required ===
# JWT signing secret — MUST change in production
JWT_SECRET=change-me-to-a-random-secret

# Admin API token for /api/admin/* endpoints
ADMIN_TOKEN=change-me-to-a-random-token

# OpenAI-compatible API configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# === Optional ===
# Default LLM model (can be changed at runtime via /api/config/model)
LLM_MODEL=gpt-4o-mini

# Database URL (defaults to SQLite)
DATABASE_URL=sqlite+aiosqlite:///./clawchat.db

# HTTP proxy for outbound requests (e.g., to OpenAI)
# OUTBOUND_PROXY=http://127.0.0.1:7890
